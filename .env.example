# Firebase web app configuration.
# Firebase console → Project settings → Your apps → SDK setup and configuration.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional. Without it, Analytics is skipped entirely.
VITE_FIREBASE_MEASUREMENT_ID=

# Domain appended to a username to build the Firebase Auth email.
# Firebase Auth has no username provider, so `ana.perez` signs in as
# `ana.perez@<this domain>`. It never has to resolve or receive mail.
VITE_AUTH_USERNAME_DOMAIN=classes.talendig.local

# Set to `true` to send Analytics events from `pnpm dev`. Off by default.
VITE_ENABLE_ANALYTICS_IN_DEV=false
